<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive-icon background: flat brand blue with a soft top-left highlight so
     the icon does not read as a dead rectangle on dark launcher wallpapers.
     108x108dp is the adaptive-icon canvas; the launcher masks it down to ~72dp. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:type="linear">
                <item android:offset="0" android:color="#FF0EA5E9" />
                <item android:offset="1" android:color="#FF0369A1" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
